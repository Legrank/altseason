{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/server.js",
    "backfill:mexc-daily-amounts": "node --experimental-sqlite --import tsx src/scripts/backfill-mexc-daily-amounts.ts",
    "import:usdt-futures": "node --experimental-sqlite --import tsx src/scripts/import-usdt-futures.ts",
    "test": "node --experimental-sqlite --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
